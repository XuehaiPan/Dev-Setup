#!/bin/bash
#
# Bootstrap a Debian or Ubuntu server by configuring the host admin and building the home directory
# template for new accounts.
#
# Usage: sudo bin/bootstrap-server [--user USER] [--set-mirrors | --no-set-mirrors] [--edit]

# shellcheck disable=SC2292 # This guard must also run under `sh`.
if [ -z "${BASH_VERSION:-}" ]; then
    echo "Bash is required to interpret this script." >&2
    exit 1
fi

set -euo pipefail
shopt -s dotglob nullglob
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"

HOME_ROOT="/home"
DATA_ROOT="/data"
SKEL_DIR="/etc/skel"
TEMPLATE_USER="server-admin"
TEMPLATE_USER_HOME="${HOME_ROOT}/${TEMPLATE_USER}"

# These values are shared with the exit trap.
AS_HOST_USER=""
CHECKOUT=""
CONTAINER=""
STAGE=""
CLEANUP_FAILED="0"
DOCKER_UNITS=()
declare -A DOCKER_WAS_ACTIVE=() DOCKER_FILE_STATE=()

function abort() {
    printf "%s\n" "$*" >&2
    exit 1
}

# shellcheck disable=SC2294 # Callers pass a shell command with its arguments already quoted.
function exec_cmd() {
    if [[ -x "/usr/bin/awk" ]]; then
        printf "%s" "$@" | /usr/bin/awk \
            'BEGIN {
                RESET = "\033[0m";
                BOLD = "\033[1m";
                UNDERLINE = "\033[4m";
                UNDERLINEOFF = "\033[24m";
                RED = "\033[31m";
                GREEN = "\033[32m";
                YELLOW = "\033[33m";
                WHITE = "\033[37m";
                GRAY = "\033[90m";
                IDENTIFIER = "[_a-zA-Z][_a-zA-Z0-9]*";
                idx = 0;
                in_string = 0;
                double_quoted = 1;
                printf("%s$", RESET BOLD WHITE);
            }
            {
                for (i = 1; i <= NF; ++i) {
                    style = WHITE;
                    post_style = WHITE;
                    if (!in_string) {
                        if ($i ~ /^-/)
                            style = YELLOW;
                        else if ($i == "sudo" && idx == 0) {
                            style = UNDERLINE GREEN;
                            post_style = UNDERLINEOFF WHITE;
                        }
                        else if ($i ~ "^" IDENTIFIER "=" && idx == 0) {
                            style = GRAY;
                            '"if (\$i ~ \"^\" IDENTIFIER \"=[\\\"']\") {"'
                                in_string = 1;
                                double_quoted = ($i ~ "^" IDENTIFIER "=\"");
                            }
                        }
                        else if ($i ~ /^[12&]?>>?/ || $i == "\\")
                            style = RED;
                        else {
                            ++idx;
                            '"if (\$i ~ /^[\"']/) {"'
                                in_string = 1;
                                double_quoted = ($i ~ /^"/);
                            }
                            if (idx == 1)
                                style = GREEN;
                        }
                    }
                    if (in_string) {
                        if (style == WHITE)
                            style = "";
                        post_style = "";
                        '"if ((double_quoted && \$i ~ /\";?\$/ && \$i !~ /\\\\\";?\$/) || (!double_quoted && \$i ~ /';?\$/))"'
                            in_string = 0;
                    }
                    if (($i ~ /;$/ && $i !~ /\\;$/) || $i == "|" || $i == "||" || $i == "&&") {
                        if (!in_string) {
                            idx = 0;
                            if ($i !~ /;$/)
                                style = RED;
                        }
                    }
                    if ($i ~ /;$/ && $i !~ /\\;$/)
                        printf(" %s%s%s;%s", style, substr($i, 1, length($i) - 1), (in_string ? WHITE : RED), post_style);
                    else
                        printf(" %s%s%s", style, $i, post_style);
                    if ($i == "\\")
                        printf("\n\t");
                }
            }
            END {
                printf("%s\n", RESET);
            }' >&2 || true
    fi
    eval "$@"
}

# Supply a trusted function and its command tracer to the target Bash process.
function script_with_exec_cmd() {
    declare -f exec_cmd "$1"
    printf '%s\n' "$1"
}

function configure_user_home() {
    exec_cmd "cd -- ${HOME@Q}"
    exec_cmd "/bin/sed -i -e 's/^DEFAULT_USER=.*/DEFAULT_USER=\"root\"/' -- .dotfiles/.zshrc"
    if [[ -x "/usr/bin/vim.basic" && ! -e ".selected_editor" && ! -L ".selected_editor" ]]; then
        exec_cmd "printf '%s\n' '# Generated by /usr/bin/select-editor' \
            'SELECTED_EDITOR=\"/usr/bin/vim.basic\"' >.selected_editor"
    fi
}

function export_template() {
    local file entry
    local -a files

    # Check the installation before exporting anything. Dev-Setup can continue after a failed download.
    for file in .linuxbrew/bin/brew Miniconda3/bin/conda .fzf/bin/fzf; do
        if [[ ! -x "${file}" ]]; then
            echo "Missing template executable: \`${file}\`" >&2
            exit 1
        fi
    done
    for file in .bash_profile .zshrc .oh-my-zsh/oh-my-zsh.sh .vim/autoload/plug.vim; do
        if [[ ! -s "${file}" ]]; then
            echo "Missing template file: \`${file}\`" >&2
            exit 1
        fi
    done
    files=(.dotfiles .linuxbrew .oh-my-zsh .fzf .vim Miniconda3 .bash_profile .zshrc)
    for entry in .bashrc .bash_logout .profile .condarc .fzf.bash .fzf.zsh .gemrc .gitconfig \
        .gitignore_global .tmux.conf .tmux.conf.local .vimrc .selected_editor .anaconda .conda .config \
        .cpan .ipython .local .perl; do
        if [[ -e "${entry}" || -L "${entry}" ]]; then
            files+=("${entry}")
        fi
    done
    # The host will own these files as root. Clear setuid and setgid bits on export.
    exec_cmd "exec /bin/tar --create --file=- --mode=a-s --exclude=.dotfiles/backups -- ${files[*]@Q}"
}

function cleanup_cmd() {
    # shellcheck disable=SC2310 # Continue restoring the other units if one cleanup command fails.
    if ! exec_cmd "$1"; then
        CLEANUP_FAILED="1"
    fi
}

function cleanup() {
    local status="$?" unit file_state
    cleanup_cmd "cd -- /"
    if [[ -n "${CHECKOUT}" ]]; then
        cleanup_cmd "${AS_HOST_USER} /usr/bin/find ${CHECKOUT@Q} -depth -delete"
    fi
    if [[ -n "${CONTAINER}" ]]; then
        cleanup_cmd "/usr/bin/docker rm --force ${CONTAINER@Q} >/dev/null"
    fi
    if [[ -n "${STAGE}" ]]; then
        cleanup_cmd "/usr/bin/find ${STAGE@Q} -depth -delete"
    fi
    for unit in "${DOCKER_UNITS[@]}"; do
        if ! file_state="$(
            /usr/bin/systemctl show --property=UnitFileState --value -- "${unit}"
        )"; then
            CLEANUP_FAILED="1"
            continue
        fi
        if [[ -n "${file_state}" ]]; then
            if /usr/bin/systemctl is-active --quiet -- "${unit}"; then
                if [[ -z "${DOCKER_WAS_ACTIVE["${unit}"]}" ]]; then
                    cleanup_cmd "/usr/bin/systemctl stop -- ${unit@Q}"
                fi
            elif [[ -n "${DOCKER_WAS_ACTIVE["${unit}"]}" ]]; then
                cleanup_cmd "/usr/bin/systemctl start -- ${unit@Q}"
            fi
        fi
        if [[ "${file_state}" == "${DOCKER_FILE_STATE["${unit}"]}" ]]; then
            continue
        fi
        case "${DOCKER_FILE_STATE["${unit}"]}" in
            masked) cleanup_cmd "/usr/bin/systemctl mask -- ${unit@Q}" ;;
            masked-runtime) cleanup_cmd "/usr/bin/systemctl mask --runtime -- ${unit@Q}" ;;
            "" | disabled | enabled | enabled-runtime)
                # Package installation can enable units even when the bootstrap only starts them.
                case "${file_state}" in
                    enabled) cleanup_cmd "/usr/bin/systemctl disable -- ${unit@Q}" ;;
                    enabled-runtime)
                        cleanup_cmd "/usr/bin/systemctl disable --runtime -- ${unit@Q}"
                        ;;
                    *) ;;
                esac
                case "${DOCKER_FILE_STATE["${unit}"]}" in
                    enabled) cleanup_cmd "/usr/bin/systemctl enable -- ${unit@Q}" ;;
                    enabled-runtime) cleanup_cmd "/usr/bin/systemctl enable --runtime -- ${unit@Q}" ;;
                    *) ;;
                esac
                ;;
            *) ;;
        esac
    done
    if [[ "${status}" != "0" ]]; then
        exit "${status}"
    fi
    exit "${CLEANUP_FAILED}"
}

USAGE="Usage: \`sudo bin/bootstrap-server [--user USER] [--set-mirrors | --no-set-mirrors] [--edit]\`"
HOST_USER="${SUDO_USER:-root}"
EDIT=""
MIRROR_OPTION=""
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --user)
            if [[ -z "${2:-}" || "$2" == -* ]]; then
                abort "Pass a local username after \`--user\`."
            fi
            HOST_USER="$2"
            shift 2
            ;;
        --user=*)
            if [[ -z "${1#*=}" ]]; then
                abort "Pass a local username after \`--user=\`."
            fi
            HOST_USER="${1#*=}"
            shift
            ;;
        --edit)
            EDIT="true"
            shift
            ;;
        --set-mirrors | --no-set-mirrors)
            if [[ -n "${MIRROR_OPTION}" && "${MIRROR_OPTION}" != "$1" ]]; then
                abort "Choose either \`--set-mirrors\` or \`--no-set-mirrors\`."
            fi
            MIRROR_OPTION="$1"
            shift
            ;;
        --help | -h)
            echo "${USAGE}"
            exit 0
            ;;
        *) abort "${USAGE}" ;;
    esac
done

ID=""
VERSION_ID=""
if [[ -r "/etc/os-release" ]]; then
    # shellcheck source=/dev/null
    source /etc/os-release
elif [[ -r "/usr/lib/os-release" ]]; then
    # shellcheck source=/dev/null
    source /usr/lib/os-release
fi
case "${ID}" in
    debian | ubuntu) ;;
    *) abort "This script requires Debian or Ubuntu." ;;
esac
if [[ "${EUID}" != "0" ]]; then
    abort "You must run this script as the root user."
fi
if [[ ! -d "${DATA_ROOT}" ]]; then
    abort "Create or mount \`${DATA_ROOT}\` before bootstrapping the server."
fi

# A keyed `getent passwd` lookup treats numeric login names as UIDs.
HOST_UID=""
while IFS=: read -r LOGIN _ LOGIN_UID LOGIN_GID _ LOGIN_HOME _; do
    if [[ "${LOGIN}" == "${HOST_USER}" ]]; then
        HOST_UID="${LOGIN_UID}"
        HOST_GID="${LOGIN_GID}"
        HOST_HOME="${LOGIN_HOME}"
        break
    fi
done </etc/passwd
if [[ -z "${HOST_UID}" ]]; then
    abort "Unknown local user: ${HOST_USER}."
fi
if [[ "${HOST_UID}" =~ ^0+$ ]]; then
    abort "Run with \`sudo bin/bootstrap-server\` from your regular account or pass \`--user USER\` from a root shell."
fi
if [[ ! -d "${HOST_HOME}" ]]; then
    abort "Missing home directory for ${HOST_USER}: ${HOST_HOME}."
fi
if [[ -n "${EDIT}" && ! -t 0 ]]; then
    abort "Run \`--edit\` from an interactive terminal."
fi

if [[ -z "${MIRROR_OPTION}" ]]; then
    MIRROR_OPTION="--no-set-mirrors"
    if [[ -t 0 ]]; then
        while read -r -p \
            "Use CERNET package mirrors on the host and in the user template? [y/N] " ANSWER; do
            case "${ANSWER,,}" in
                y | yes)
                    MIRROR_OPTION="--set-mirrors"
                    break
                    ;;
                n | no | "") break ;;
                *) echo "Enter yes or no." >&2 ;;
            esac
        done
    fi
fi
DEV_SETUP_OPTIONS=(--force-per-user-homebrew --non-interactive "${MIRROR_OPTION}")

export DEBIAN_FRONTEND="noninteractive"
if [[ ! -x "/usr/bin/sudo" ]]; then
    exec_cmd "/usr/bin/apt-get update"
    exec_cmd "/usr/bin/apt-get install --yes --no-install-recommends sudo"
fi

# Keep the same terminal for the user's sudo timestamp and start with their own environment.
# The leading `+` forces numeric IDs even when another login or group has the same name.
AS_HOST_USER="/usr/bin/setpriv --reuid=+${HOST_UID@Q} --regid=+${HOST_GID@Q} \
    --init-groups --reset-env --"
HOST_SUDO="${AS_HOST_USER} /usr/bin/sudo"
if [[ ! -t 0 ]]; then
    HOST_SUDO+=" -n"
fi
echo "==> Checking sudo access for ${HOST_USER} ..."
# shellcheck disable=SC2310 # Identify the failing account and APT operation.
if ! exec_cmd "${HOST_SUDO} DEBIAN_FRONTEND=${DEBIAN_FRONTEND@Q} /usr/bin/apt-get update"; then
    abort "Could not run \`sudo apt-get update\` as ${HOST_USER}. Check the sudo and APT output above."
fi

echo "==> Installing prerequisites ..."
PACKAGES=(
    bzip2 ca-certificates coreutils curl diffutils file findutils git grep gzip less mawk passwd
    procps sed tar unzip wget xz-utils zsh
)
exec_cmd "/usr/bin/apt-get install --yes --no-install-recommends \
    ${PACKAGES[*]} adduser mount perl rsync util-linux"

if [[ -d "/run/systemd/system" && -x "/usr/bin/systemctl" ]]; then
    DOCKER_UNITS=(docker.service docker.socket containerd.service)
fi
for UNIT in "${DOCKER_UNITS[@]}"; do
    DOCKER_FILE_STATE["${UNIT}"]="$(
        /usr/bin/systemctl show --property=UnitFileState --value -- "${UNIT}"
    )"
    DOCKER_WAS_ACTIVE["${UNIT}"]=""
    if /usr/bin/systemctl is-active --quiet -- "${UNIT}"; then
        DOCKER_WAS_ACTIVE["${UNIT}"]="true"
    fi
done
trap cleanup EXIT
trap "exit 129" HUP
trap "exit 130" INT
trap "exit 143" TERM

echo "==> Running Dev-Setup as ${HOST_USER} ..."
exec_cmd "cd -- ${HOST_HOME@Q}"
CHECKOUT="$(exec_cmd "${AS_HOST_USER} /usr/bin/mktemp -d -- /tmp/Dev-Setup.XXXXXXXX")"
exec_cmd "${AS_HOST_USER} /usr/bin/git clone -- \
    https://github.com/XuehaiPan/Dev-Setup.git ${CHECKOUT@Q}"
exec_cmd "cd -- ${CHECKOUT@Q}"
# Refresh the user's credentials if they expired during package installation or cloning.
exec_cmd "${HOST_SUDO} /bin/mkdir -p /"
exec_cmd "${AS_HOST_USER} /bin/bash setup.sh ${DEV_SETUP_OPTIONS[*]}"
script_with_exec_cmd configure_user_home | exec_cmd "${AS_HOST_USER} /bin/bash -seuo pipefail"

echo "==> Setting up Docker ..."
for UNIT in "${DOCKER_UNITS[@]}"; do
    case "${DOCKER_FILE_STATE["${UNIT}"]}" in
        masked) exec_cmd "/usr/bin/systemctl unmask -- ${UNIT@Q}" ;;
        masked-runtime) exec_cmd "/usr/bin/systemctl unmask --runtime -- ${UNIT@Q}" ;;
        *) ;;
    esac
done
DOCKER_SERVICE_LOAD_STATE=""
if [[ "${#DOCKER_UNITS[@]}" -gt 0 ]]; then
    DOCKER_SERVICE_LOAD_STATE="$(
        /usr/bin/systemctl show --property=LoadState --value -- docker.service
    )"
fi
if [[ ! -x "/usr/bin/docker" || "${DOCKER_SERVICE_LOAD_STATE}" == "not-found" ]]; then
    exec_cmd "/usr/bin/curl -fsSL -- https://get.docker.com | /bin/sh -s -- --no-autostart"
fi
if [[ "${#DOCKER_UNITS[@]}" -gt 0 ]]; then
    exec_cmd "/usr/bin/systemctl start -- docker.service"
fi
if ! /usr/bin/docker info >/dev/null; then
    abort "Cannot reach the Docker daemon. Check \`docker context show\` and \`docker info\` with the same privileges and environment as the bootstrap."
fi

HOST_ARCH="$(/usr/bin/dpkg --print-architecture)"
echo "==> Building the user template in ${ID}:${VERSION_ID} for ${HOST_ARCH} ..."
CONTAINER="$(exec_cmd "/usr/bin/docker run --detach ${ID@Q}:${VERSION_ID@Q} /bin/sleep infinity")"
TEMPLATE_ARCH="$(exec_cmd "/usr/bin/docker exec ${CONTAINER@Q} /usr/bin/dpkg --print-architecture")"
if [[ "${TEMPLATE_ARCH}" != "${HOST_ARCH}" ]]; then
    abort "Template architecture ${TEMPLATE_ARCH} differs from host architecture ${HOST_ARCH}. Select a matching Docker platform or context."
fi
exec_cmd "/usr/bin/docker exec --env DEBIAN_FRONTEND ${CONTAINER@Q} /usr/bin/apt-get update"
exec_cmd "/usr/bin/docker exec --env DEBIAN_FRONTEND ${CONTAINER@Q} \
    /usr/bin/apt-get install --yes --no-install-recommends ${PACKAGES[*]} \
    build-essential git-lfs openssh-client perl ruby sudo tmux vim"
exec_cmd "/usr/bin/docker exec ${CONTAINER@Q} \
    /usr/sbin/useradd --create-home --home-dir ${TEMPLATE_USER_HOME@Q} --skel ${SKEL_DIR@Q} \
    --user-group --shell /bin/bash -- ${TEMPLATE_USER@Q}"
exec_cmd "/usr/bin/docker exec -i ${CONTAINER@Q} \
    /usr/bin/install -m 0440 -- /dev/stdin /etc/sudoers.d/${TEMPLATE_USER@Q}" \
    <<<"${TEMPLATE_USER} ALL=(ALL:ALL) NOPASSWD: ALL"

AS_TEMPLATE_USER=(
    --user "${TEMPLATE_USER}" --env "HOME=${TEMPLATE_USER_HOME}" --env "USER=${TEMPLATE_USER}"
    --env "LOGNAME=${TEMPLATE_USER}" --workdir "${TEMPLATE_USER_HOME}"
)
exec_cmd "/usr/bin/docker exec ${AS_TEMPLATE_USER[*]@Q} ${CONTAINER@Q} \
    /usr/bin/sudo -n /bin/mkdir -p /"
exec_cmd "/usr/bin/docker exec ${AS_TEMPLATE_USER[*]@Q} ${CONTAINER@Q} /bin/mkdir -- Dev-Setup"
# Export tracked sources only. The host user's Git settings and credentials stay in their home.
exec_cmd "${AS_HOST_USER} /usr/bin/git -C ${CHECKOUT@Q} archive HEAD | \
    /usr/bin/docker exec -i ${AS_TEMPLATE_USER[*]@Q} ${CONTAINER@Q} /bin/tar -x -C Dev-Setup"
exec_cmd "/usr/bin/docker exec ${AS_TEMPLATE_USER[*]@Q} ${CONTAINER@Q} \
    /bin/bash Dev-Setup/setup.sh ${DEV_SETUP_OPTIONS[*]}"
script_with_exec_cmd configure_user_home | exec_cmd "/usr/bin/docker exec -i \
    ${AS_TEMPLATE_USER[*]@Q} ${CONTAINER@Q} /bin/bash -seuo pipefail"
if [[ -n "${EDIT}" ]]; then
    echo "==> Edit the template home, then run \`exit\` to publish it."
    exec_cmd "/usr/bin/docker exec -it ${AS_TEMPLATE_USER[*]@Q} ${CONTAINER@Q} /bin/bash -l"
fi

echo "==> Copying the template to \`${SKEL_DIR}\` ..."
STAGE="$(exec_cmd "/usr/bin/mktemp -d -- ${DATA_ROOT@Q}/.bootstrap-server.XXXXXXXX")"
script_with_exec_cmd export_template | exec_cmd "/usr/bin/docker exec -i ${AS_TEMPLATE_USER[*]@Q} \
    ${CONTAINER@Q} /bin/bash -seuo pipefail | \
    /bin/tar --extract --file=- --directory=${STAGE@Q} \
    --no-same-owner --same-permissions"
exec_cmd "/bin/touch -- ${STAGE@Q}/put-things-in-data-instead-of-home"

# Passing individual entries limits deletion to exported directories and preserves the root mode.
exec_cmd "/usr/bin/rsync -aH --delete --delay-updates --chown=root:root -- ${STAGE@Q}/* ${SKEL_DIR@Q}/"

echo "==> Configured ${HOST_USER} and built the user template in \`${SKEL_DIR}\`."
echo "==> Create an account with \`sudo bin/add-user USER\`."
