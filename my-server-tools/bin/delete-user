#!/bin/bash
#
# Remove a user and their home and data directories.
#
# Usage: sudo bin/delete-user USERNAME

# shellcheck disable=SC2292 # This guard must also run under `sh`.
if [ -z "${BASH_VERSION:-}" ]; then
    echo "Bash is required to interpret this script." >&2
    exit 1
fi

set -euo pipefail
export PATH="/usr/sbin:/usr/bin:/sbin:/bin"

DATA_ROOT="/data"
TEMPLATE_USER="server-admin"

function abort() {
    printf "%s\n" "$*" >&2
    exit 1
}

function local_account_uid() {
    local entries login uid match=""
    # Enumerate local accounts because `getent passwd KEY` treats numeric keys as UIDs.
    entries="$(/usr/bin/getent -s files passwd)" || return "$?"
    if [[ -z "${entries}" ]]; then
        echo "Could not read local accounts with \`getent -s files passwd\`." >&2
        return 1
    fi
    while IFS=: read -r login _ uid _; do
        if [[ "${login}" == "$1" ]]; then
            if [[ -n "${match}" ]]; then
                echo "Multiple local accounts named ${login}." >&2
                return 1
            fi
            match="${uid}"
        fi
    done <<<"${entries}"
    printf '%s\n' "${match}"
}

function require_debian_root() {
    # `os-release` supplies the uppercase fields `ID` and `ID_LIKE`.
    local ID="" ID_LIKE="" release="/etc/os-release"
    if [[ ! -r "${release}" ]]; then
        release="/usr/lib/os-release"
    fi
    if [[ -r "${release}" ]]; then
        # shellcheck source=/dev/null
        source "${release}"
    fi
    case " ${ID} ${ID_LIKE} " in
        *" debian "* | *" ubuntu "*) ;;
        *) abort "This script requires Debian, Ubuntu, or a derivative." ;;
    esac
    if [[ "${EUID}" -ne 0 ]]; then
        abort "You must run this script as the root user."
    fi
}

# shellcheck disable=SC2294 # Callers pass a shell command with its arguments already quoted.
function exec_cmd() {
    printf "%s" "$@" | /usr/bin/awk \
        'BEGIN {
            RESET = "\033[0m";
            BOLD = "\033[1m";
            UNDERLINE = "\033[4m";
            UNDERLINEOFF = "\033[24m";
            RED = "\033[31m";
            GREEN = "\033[32m";
            YELLOW = "\033[33m";
            WHITE = "\033[37m";
            GRAY = "\033[90m";
            IDENTIFIER = "[_a-zA-Z][_a-zA-Z0-9]*";
            idx = 0;
            in_string = 0;
            double_quoted = 1;
            printf("%s$", RESET BOLD WHITE);
        }
        {
            for (i = 1; i <= NF; ++i) {
                style = WHITE;
                post_style = WHITE;
                if (!in_string) {
                    if ($i ~ /^-/)
                        style = YELLOW;
                    else if ($i == "sudo" && idx == 0) {
                        style = UNDERLINE GREEN;
                        post_style = UNDERLINEOFF WHITE;
                    }
                    else if ($i ~ "^" IDENTIFIER "=" && idx == 0) {
                        style = GRAY;
                        '"if (\$i ~ \"^\" IDENTIFIER \"=[\\\"']\") {"'
                            in_string = 1;
                            double_quoted = ($i ~ "^" IDENTIFIER "=\"");
                        }
                    }
                    else if ($i ~ /^[12&]?>>?/ || $i == "\\")
                        style = RED;
                    else {
                        ++idx;
                        '"if (\$i ~ /^[\"']/) {"'
                            in_string = 1;
                            double_quoted = ($i ~ /^"/);
                        }
                        if (idx == 1)
                            style = GREEN;
                    }
                }
                if (in_string) {
                    if (style == WHITE)
                        style = "";
                    post_style = "";
                    '"if ((double_quoted && \$i ~ /\";?\$/ && \$i !~ /\\\\\";?\$/) || (!double_quoted && \$i ~ /';?\$/))"'
                        in_string = 0;
                }
                if (($i ~ /;$/ && $i !~ /\\;$/) || $i == "|" || $i == "||" || $i == "&&") {
                    if (!in_string) {
                        idx = 0;
                        if ($i !~ /;$/)
                            style = RED;
                    }
                }
                if ($i ~ /;$/ && $i !~ /\\;$/)
                    printf(" %s%s%s;%s", style, substr($i, 1, length($i) - 1), (in_string ? WHITE : RED), post_style);
                else
                    printf(" %s%s%s", style, $i, post_style);
                if ($i == "\\")
                    printf("\n\t");
            }
        }
        END {
            printf("%s\n", RESET);
        }' >&2 || true
    eval "$@"
}

USAGE="Usage: \`sudo bin/delete-user USERNAME\`"
if [[ "$#" -eq 1 && ("$1" == "-h" || "$1" == "--help") ]]; then
    echo "${USAGE}"
    exit 0
fi
if [[ "$#" -ne 1 || -z "${1:-}" || "$1" == -* ]]; then
    abort "${USAGE}"
fi
USERNAME="$1"
if [[ "${USERNAME}" == */* || "${USERNAME}" == "." || "${USERNAME}" == ".." ]]; then
    abort "Username cannot contain '/' or equal '.' or '..'."
fi

require_debian_root

if [[ "${USERNAME}" == "${TEMPLATE_USER}" ]]; then
    abort "The ${TEMPLATE_USER} account is protected and cannot be deleted."
fi

if [[ "${USERNAME}" == "shared-data" ]]; then
    abort "Username shared-data is reserved for \`${DATA_ROOT}/shared-data\`."
fi

# Check the local UID because `id` can resolve the same login name from a remote directory.
TARGET_UID="$(local_account_uid "${USERNAME}")"
if [[ -z "${TARGET_UID}" ]]; then
    abort "No local account named ${USERNAME} in \`/etc/passwd\`."
fi
if [[ "${TARGET_UID}" =~ ^0+$ ]]; then
    abort "Refusing to delete ${USERNAME} because it has UID 0."
fi

DATA_DIR="$(/usr/bin/realpath -m -- "${DATA_ROOT}")/${USERNAME}"
# The fifth mountinfo field is the mount point, with special characters escaped in octal.
while read -r _ _ _ _ MOUNT_POINT _; do
    printf -v MOUNT_POINT '%b' "${MOUNT_POINT}"
    if [[ "${MOUNT_POINT}" == "${DATA_DIR}" || "${MOUNT_POINT}" == "${DATA_DIR}/"* ]]; then
        abort "Unmount \`${MOUNT_POINT}\` before deleting ${USERNAME}."
    fi
done </proc/self/mountinfo

echo "==> Removing user ..."

DELUSER_ERROR=""
# shellcheck disable=SC2310 # Check whether the account is gone even if `deluser` reports an error.
exec_cmd "/usr/sbin/deluser --remove-home -- ${USERNAME@Q}" || DELUSER_ERROR="$?"
# shellcheck disable=SC2310 # A failed local lookup must preserve the data.
if ! TARGET_UID="$(local_account_uid "${USERNAME}")"; then
    echo "Could not confirm removal of ${USERNAME}. Keeping \`${DATA_DIR}\`." >&2
    exit "${DELUSER_ERROR:-1}"
fi
if [[ -n "${TARGET_UID}" ]]; then
    echo "Account ${USERNAME} still exists. Keeping \`${DATA_DIR}\`." >&2
    exit "${DELUSER_ERROR:-1}"
fi
# shellcheck disable=SC2310 # Preserve the original `deluser` error if data cleanup also fails.
exec_cmd "/bin/rm -rf -- ${DATA_DIR@Q}" || exit "${DELUSER_ERROR:-"$?"}"

if [[ -n "${DELUSER_ERROR}" ]]; then
    exit "${DELUSER_ERROR}"
fi
echo "==> Successfully removed user ${USERNAME}."
