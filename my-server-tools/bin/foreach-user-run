#!/bin/bash
#
# Run a Bash expression in each local user's home directory.
#
# Usage: sudo bin/foreach-user-run [--keep-going] [--] 'COMMAND'

# shellcheck disable=SC2292 # This guard must also run under `sh`.
if [ -z "${BASH_VERSION:-}" ]; then
    echo "Bash is required to interpret this script." >&2
    exit 1
fi

set -euo pipefail
shopt -s dotglob nullglob

HOME_ROOT="/home"

function abort() {
    printf "%s\n" "$*" >&2
    exit 1
}

function require_debian_root() {
    # `os-release` supplies the uppercase fields `ID` and `ID_LIKE`.
    local ID="" ID_LIKE="" release="/etc/os-release"
    if [[ ! -r "${release}" ]]; then
        release="/usr/lib/os-release"
    fi
    if [[ -r "${release}" ]]; then
        # shellcheck source=/dev/null
        source "${release}"
    fi
    case " ${ID} ${ID_LIKE} " in
        *" debian "* | *" ubuntu "*) ;;
        *) abort "This script requires Debian, Ubuntu, or a derivative." ;;
    esac
    if [[ "${EUID}" -ne 0 ]]; then
        abort "You must run this script as the root user."
    fi
}

USAGE="Usage: \`sudo bin/foreach-user-run [--keep-going] [--] 'COMMAND'\`"
KEEP_GOING=""
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --keep-going) KEEP_GOING="true" ;;
        -h | --help)
            echo "${USAGE}"
            echo "Bash (\`/bin/bash\`) evaluates the command regardless of the user's login shell."
            echo "Use \`--keep-going\` to continue after failures and return the first failure code."
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*) abort "${USAGE}" ;;
        *) break ;;
    esac
    shift
done
if [[ "$#" -ne 1 || "${1:-}" != *[![:space:]]* ]]; then
    abort "Pass exactly one nonblank command string. ${USAGE}"
fi

COMMAND="$1"

require_debian_root

# Save the terminal before piping the command. Batch runs use `/dev/null` for input.
if [[ -t 0 ]]; then
    exec {SESSION_INPUT}<&0
else
    exec {SESSION_INPUT}</dev/null
fi

# A keyed `getent passwd` lookup treats numeric login names as UIDs.
PASSWD_ENTRIES="$(/usr/bin/getent -s files passwd)"
declare -A ACCOUNT_HOMES=()
while IFS=: read -r LOGIN _ _ _ _ ACCOUNT_HOME _; do
    if [[ -n "${LOGIN}" && -z "${ACCOUNT_HOMES["${LOGIN}"]+set}" ]]; then
        ACCOUNT_HOMES["${LOGIN}"]="${ACCOUNT_HOME}"
    fi
done <<<"${PASSWD_ENTRIES}"

FIRST_FAILURE=0
FAILURES=()
for HOME_DIR in "${HOME_ROOT}"/*; do
    USERNAME="${HOME_DIR##*/}"
    if [[ ! -d "${HOME_DIR}" || "${USERNAME}" == "lost+found" ||
        "${ACCOUNT_HOMES["${USERNAME}"]:-}" != "${HOME_DIR}" ]]; then
        continue
    fi

    echo "==> Running as user ${USERNAME} ..."
    # Send the NUL-terminated expression on a separate descriptor to keep stdin on the terminal.
    # shellcheck disable=SC2016 # The per-user Bash expands this script.
    if printf "%s\0" "${COMMAND}" | USER="${USERNAME}" HOME="${HOME_DIR}" \
        /sbin/runuser --pty --shell=/bin/bash \
        --whitelist-environment="http_proxy,https_proxy,ftp_proxy,all_proxy,no_proxy" \
        -- "${USERNAME}" -ic '
if ! IFS="" read -r -d "" -u 3 __FOREACH_USER_COMMAND; then
    printf "%s\n" "Could not read the per-user command." >&2
    exit 1
fi
exec 3<&-
printf "%s$ %s\n" "${USER}@${PWD}" "source ~/.bash_profile"
source ~/.bash_profile
printf "%s$ %s\n" "${USER}@${PWD}" "cd -- ~"
cd -- ~ || exit "$?"
printf "%s$ %s\n" "${USER}@${PWD}" "${__FOREACH_USER_COMMAND}"
eval -- "${__FOREACH_USER_COMMAND}"
' 3<&0 0<&"${SESSION_INPUT}" {SESSION_INPUT}<&-; then
        echo "==> Finished running as user ${USERNAME} with exit code 0."
    else
        EXIT_CODE="$?"
        echo "==> Finished running as user ${USERNAME} with exit code ${EXIT_CODE}." >&2
        if [[ -z "${KEEP_GOING}" ]]; then
            echo "==> Stopping on first failure." >&2
            exit "${EXIT_CODE}"
        fi
        if [[ "${FIRST_FAILURE}" -eq 0 ]]; then
            FIRST_FAILURE="${EXIT_CODE}"
        fi
        FAILURES+=("${USERNAME} (exit code ${EXIT_CODE})")
    fi
done

if [[ "${FIRST_FAILURE}" -ne 0 ]]; then
    echo "==> Failed accounts:" >&2
    printf '    %s\n' "${FAILURES[@]}" >&2
    exit "${FIRST_FAILURE}"
fi
echo "==> Successfully ran command as each user."
